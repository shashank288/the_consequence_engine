# Copy to .env and fill in. .env is gitignored — NEVER commit a real key.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# Nothing in the code calls load_dotenv(), so pass the file to uvicorn:
#   py -3.12 -m uvicorn src.app:app --port 8000 --env-file .env
# Tests and the fixture golden path need NO key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
CASE_DB=cases.json
