# Copy to .env and fill in. .env is gitignored — NEVER put a real key in THIS file.
#   PowerShell: Copy-Item .env.example .env
# config.py loads .env automatically (python-dotenv), so plain uvicorn works:
#   py -3.12 -m uvicorn src.app:app --port 8000
# Tests and the fixture golden path need NO key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
CASE_DB=cases.json
